{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/cs01/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pipeline-audit",
          "version": "1.0.0",
          "informationUri": "https://github.com/jrmywm/pipeline-audit",
          "rules": [
            {
              "id": "GHA-R002",
              "name": "GHA-R002",
              "shortDescription": {
                "text": "GitHub secret interpolated into executable script"
              },
              "fullDescription": {
                "text": "Pass secrets to the step via the `env:` mapping and reference them as `$VAR_NAME` inside the bash script. Never interpolate `${{ secrets.* }}` directly into a run block."
              },
              "helpUri": "https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-secrets-securely",
              "help": {
                "text": "Pass secrets to the step via the `env:` mapping and reference them as `$VAR_NAME` inside the bash script. Never interpolate `${{ secrets.* }}` directly into a run block."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "GHA-R001",
              "name": "GHA-R001",
              "shortDescription": {
                "text": "Unpinned GitHub Action (uses tag or branch instead of SHA)"
              },
              "fullDescription": {
                "text": "Pin the action to a full 40-character commit SHA instead of a tag or branch reference, e.g. `uses: actions/checkout@<40-hex-sha>`."
              },
              "helpUri": "https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-third-party-actions",
              "help": {
                "text": "Pin the action to a full 40-character commit SHA instead of a tag or branch reference, e.g. `uses: actions/checkout@<40-hex-sha>`."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "DOCKER-R002",
              "name": "DOCKER-R002",
              "shortDescription": {
                "text": "Hardcoded secret in ENV or ARG instruction"
              },
              "fullDescription": {
                "text": "Move secrets out of the image layer. Inject at runtime via Vault, GitHub secrets, docker secrets, or SOPS-encrypted files."
              },
              "helpUri": "https://docs.github.com/en/actions/security-guides/encrypted-secrets",
              "help": {
                "text": "Move secrets out of the image layer. Inject at runtime via Vault, GitHub secrets, docker secrets, or SOPS-encrypted files."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "DOCKER-R001",
              "name": "DOCKER-R001",
              "shortDescription": {
                "text": "Final container stage may run as root"
              },
              "fullDescription": {
                "text": "Add a USER instruction near the end of the Dockerfile to specify a non-root user, e.g. `USER 1001` or `USER appuser`."
              },
              "helpUri": "https://docs.docker.com/develop/develop-images/dockerfile_best-practices/#user",
              "help": {
                "text": "Add a USER instruction near the end of the Dockerfile to specify a non-root user, e.g. `USER 1001` or `USER appuser`."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
