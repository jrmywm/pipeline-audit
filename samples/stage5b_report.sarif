  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pipeline-audit",
          "version": "0.1.0a1",
          "informationUri": "https://github.com/TODO/pipeline-audit",
          "rules": [
            {
              "id": "GHA-R001",
              "name": "GHA-R001",
              "shortDescription": {
                "text": "Unpinned GitHub Action (uses tag or branch instead of SHA)"
              },
              "fullDescription": {
                "text": "Pin the action to a full 40-character commit SHA instead of a tag or branch reference, e.g. `uses: actions/checkout@<40-hex-sha>`."
              },
              "helpUri": "https://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-third-party-actions",
              "help": {
                "text": "Pin the action to a full 40-character commit SHA instead of a tag or branch reference, e.g. `uses: actions/checkout@<40-hex-sha>`."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "DOCKER-R001",
              "name": "DOCKER-R001",
              "shortDescription": {
                "text": "Container runs as root (no USER directive)"
              },
              "fullDescription": {
                "text": "Add a USER instruction near the end of the Dockerfile to specify a non-root user, e.g. `USER 1001` or `USER appuser`."
              },
              "helpUri": "https://docs.docker.com/develop/develop-images/dockerfile_best-practices/#user",
              "help": {
                "text": "Add a USER instruction near the end of the Dockerfile to specify a non-root user, e.g. `USER 1001` or `USER appuser`."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
